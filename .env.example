# Copy to .env and fill in your own values. Never commit .env.

# Local PostgreSQL (npm run db:start or docker compose up -d)
DB_PORT=5433
DB_USER=marginflow
DB_PASSWORD=change-me
DB_NAME=marginflow
DATABASE_URL=postgresql://marginflow:change-me@localhost:5433/marginflow

# Auth.js — generate: npx auth secret  (or any long random string)
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# Read-only token for the AI agent API
AGENT_API_TOKEN=change-me

# Demo user passwords used by `npm run db:seed`
SEED_ADMIN_PASSWORD=change-me
SEED_MANAGER_PASSWORD=change-me
SEED_EMPLOYEE_PASSWORD=change-me
