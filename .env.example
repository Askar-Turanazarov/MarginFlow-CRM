# Copy to .env and fill in your own values. Never commit .env.

# Local PostgreSQL (npm run db:start or docker compose up -d)
DB_PORT=5433
DB_USER=marginflow
DB_PASSWORD=change-me
DB_NAME=marginflow
DATABASE_URL=postgresql://marginflow:change-me@localhost:5433/marginflow

# Auth.js — generate: npx auth secret  (or any long random string)
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# Secret key of the MCP server (npm run mcp). At least 32 characters; without it the server does not start.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=change-me
# Let the agent take a request away from its assignee (off by default)
# MCP_ALLOW_REASSIGN=1
# MCP_PORT=3333

# Token for office sensors / trackers sending positions to POST /api/positions (at least 16 characters).
# Leave change-me to keep the sensor API off. Generate: openssl rand -hex 24
POSITIONS_API_TOKEN=change-me

# Demo user passwords used by `npm run db:seed`
SEED_ADMIN_PASSWORD=change-me
SEED_MANAGER_PASSWORD=change-me
SEED_EMPLOYEE_PASSWORD=change-me
SEED_TRACKER_PASSWORD=

# Quick login without a password: npm run dev on localhost only. Never set it on a server.
DEV_LOGIN=1

# Secret of the daily cleanup route /api/cron/retention (set it in Vercel too). At least 16 characters.
CRON_SECRET=change-me
